# Kopiere diese Datei nach .env und passe sie pro Gerät an. Die .env wird nicht committet.

# OpenAI-kompatible API des lokalen Modellservers (LM Studio: Port 1234)
LLM_BASE_URL=http://localhost:1234/v1

# Nur falls der Modellserver einen API-Schlüssel verlangt (LM Studio: "Require API key")
# LLM_API_KEY=

# Modell-ID, wie sie /v1/models meldet
# Laptop (GTX 1050 Ti, 4 GB VRAM): kleines Gemma
# PC (RTX 4090, 24 GB VRAM): großes Qwen aus LM Studio
LLM_MODEL=gemma-4-e2b-it
